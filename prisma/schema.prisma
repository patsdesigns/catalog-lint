// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
model Scan {
  id         Int      @id @default(autoincrement())
  shop       String
  score      Int
  total      Int
  clean      Int
  durationMs Int
  rules      String
  findings   String
  checks     String   @default("[]")
  names      String   @default("[]")
  catalogTotal Int    @default(0)
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
}
model DictionaryWord {
  id        Int      @id @default(autoincrement())
  shop      String
  word      String
  createdAt DateTime @default(now())

  @@unique([shop, word])
}
model FixLog {
  id        Int      @id @default(autoincrement())
  shop      String
  batchId   String
  ruleId    String
  field     String
  targetId  String
  productId String
  title     String
  before    String
  after     String
  undone    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([shop, batchId])
}
model Ignore {
  id        Int      @id @default(autoincrement())
  shop      String
  key       String
  ruleId    String
  productId String
  title     String
  detail    String
  createdAt DateTime @default(now())

  @@unique([shop, key])
}
model Setting {
  shop            String   @id
  vendorWhitelist String   @default("[]")
  metafieldRules  String   @default("[]")
  disabledRules   String   @default("[]")
  preset          String   @default("recommended")
  updatedAt       DateTime @updatedAt
}

model ScanJob {
  id          Int      @id @default(autoincrement())
  shop        String
  operationId String
  status      String   @default("running")
  expected    Int      @default(0)
  objects     Int      @default(0)
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop, status])
}

model SupportMessage {
  id        Int      @id @default(autoincrement())
  shop      String
  name      String
  email     String
  category  String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}
